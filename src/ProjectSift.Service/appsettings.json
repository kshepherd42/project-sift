{
  "UploadLimits": {
    "MaxRequestBytes": 10485760,
    "MaxFileBytes": 2097152,
    "MaxFileCount": 32
  },
  "Extraction": {
    "MaxCandidateBytes": 1048576,
    "MaxNestingDepth": 64,
    "MaxPathsPerDocument": 4096,
    "MaxDocumentsPerPayload": 512
  },
  "BackgroundProcessing": {
    "QueueCapacity": 256
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
